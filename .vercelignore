# Keep development, documentation, credentials, and local project metadata
# out of deployments. Public HTML, assets, SEO files, and api/** are included.
.DS_Store
.env*
.git/
.github/
.vercel/
node_modules/
scripts/
tmp/
translations/
*.md
CNAME

# Ignore macOS/iCloud conflict copies such as "page 2.html". Keep the local
# files untouched, but never publish them as accidental duplicate URLs.
* [0-9].html
* [0-9][0-9].html
* [0-9][0-9][0-9].html
* [0-9].webmanifest
* [0-9][0-9].webmanifest
* [0-9][0-9][0-9].webmanifest

# Ignore iCloud conflict copies created inside generated catalog image folders.
assets/catalog/products/* [0-9].jpg
assets/catalog/products/* [0-9][0-9].jpg
assets/catalog/previews/* [0-9].jpg
assets/catalog/previews/* [0-9][0-9].jpg

# Clean source masters are build inputs. Only their optimized card and preview
# derivatives are public.
assets/catalog/clean-sources/

# Catalog build reports, unused category fallbacks, and superseded previews are
# local inputs/audits rather than public site assets.
assets/catalog/import-report.json
assets/catalog/curated-products.json
assets/catalog/categories/
assets/catalog/previews/60697040446.jpg
